    uint32_t saved=binding_objects[23].guid;binding_objects[23].guid=binding_objects[0].guid;
    assert(ug_scene_init(&p.scene,&pk,NULL));assert(!pause_bind_detect(&p));ug_scene_free(&p.scene);
